# ============================================
# BTRFS BACKUP MANAGER — ПРИМЕР НАСТРОЕК
# ============================================
# Это ПРИМЕР без реальных паролей. Рабочий файл — backup_config.py
# в корне проекта:
#     cp backup_config.py.example backup_config.py
#     chown root:root backup_config.py && chmod 600 backup_config.py
#
# Для отдельного задания cron или приемочных испытаний можно запустить
# программу с другим файлом настроек:
#     python3 main.py backup --config /путь/файла.py
# Отдельного управления профилями в программе нет.
#
# Формат каждого параметра: назначение; допустимые значения; значение
# по умолчанию; последствия изменения.

# Источники резервного копирования.
# Допустимо: список путей ("/", "/home") или словарей с индивидуальными
#   каталогами; умолчание: нет (не задан — интерактивный режим предложит
#   выбор из обнаруженных subvolume);
# последствия: каждый элемент резервируется отдельным снапшотом и своим
#   архивом; вложенные subvolume в снапшот родителя не входят.
SUBVOLUMES = [
    "/",
    # {"name": "home", "source": "/home",
    #  "snapshot_dir": "/home/.snapshots",
    #  "local_backup_dir": "/var/backups/btrfs/home"},
]

# Каталог локальных read-only снапшотов.
# Допустимо: абсолютный путь на ТОЙ ЖЕ файловой системе Btrfs, что и
#   источник (проверяется по UUID); умолчание: нет;
# последствия: каталог не должен находиться внутри источника (иначе
#   снапшоты включали бы друг друга); допустимое исключение — каталог
#   как отдельный subvolume.
SNAPSHOT_DIR = "/.snapshots"

# Каталог локальных архивов.
# Допустимо: абсолютный путь или None; умолчание: None;
# последствия: None — используется SNAPSHOT_DIR/backup; заданный путь
#   применяется ко всем источникам без индивидуального local_backup_dir.
LOCAL_BACKUP_DIR = None

# Основной алгоритм сжатия архивов.
# Допустимо: "zstd" или "gzip"; умолчание: "zstd";
# последствия: zstd обычно быстрее; при отсутствии утилиты используется
#   COMPRESSION_FALLBACK (см. ниже).
COMPRESSION = "zstd"

# Резервный алгоритм сжатия.
# Допустимо: "zstd" или "gzip"; умолчание: "gzip";
# последствия: применяется, если основная утилита не установлена.
COMPRESSION_FALLBACK = "gzip"

# Автоматический fallback в неинтерактивном режиме.
# Допустимо: True или False; умолчание: True;
# последствия: False — отсутствие основной утилиты завершает операцию
#   ошибкой вместо перехода на резервный алгоритм.
CRON_COMPRESSION_FALLBACK = True

# Уровень сжатия gzip.
# Допустимо: целое 1-9; умолчание: 6;
# последствия: больше — лучше сжатие, дольше работа.
GZIP_LEVEL = 6

# Уровень сжатия zstd.
# Допустимо: целое 1-19; умолчание: 3;
# последствия: для резервных копий разумен диапазон 1-3.
ZSTD_LEVEL = 3

# Программа GPG.
# Допустимо: путь к исполняемому файлу; умолчание: /usr/bin/gpg;
# последствия: используется для шифрования и проверки архивов.
GPG_BINARY = "/usr/bin/gpg"

# Пароль симметричного шифрования (AES256).
# Допустимо: строка или "CHANGE_ME" (заполнитель); умолчание: нет;
# последствия: для cron должен быть задан настоящий пароль; в
#   интерактивном режиме без пароля в файле вводится скрыто. Пароль
#   НИКОГДА не попадает в argv, логи и диагностические отчеты.
GPG_PASSWORD = "CHANGE_ME"

# Использовать сетевое хранилище.
# Допустимо: True или False; умолчание: True;
# последствия: False — сетевые проверки и отправка не выполняются вовсе.
NETWORK_ENABLED = True

# Точка монтирования сетевой шары.
# Допустимо: абсолютный путь (шара монтируется заранее) или None;
#   умолчание: нет;
# последствия: None — сетевое хранилище не используется.
NETWORK_MOUNT = "/mnt/backup"

# Каталог внутри сетевой шары.
# Допустимо: относительный путь без ".."; умолчание: "btrfs-backups";
# последствия: архивы складываются в этот подкаталог шары.
NETWORK_DIRECTORY = "btrfs-backups"

# Автоматическая отправка после успешного backup.
# Допустимо: True или False; умолчание: True;
# последствия: False — архивы остаются локально со статусом
#   upload-pending и отправляются командой upload-pending.
AUTO_UPLOAD = True

# Дополнительная диагностическая проба записи на шаре.
# Допустимо: True или False; умолчание: True;
# последствия: проверка РЕАЛЬНОГО монтирования выполняется всегда и
#   этой настройкой не отключается; здесь управляется только проба.
CHECK_NETWORK_MOUNT = True

# Ожидаемый тип файловой системы сетевой шары.
# Допустимо: "nfs", "cifs", "sshfs", ... или None; умолчание: None;
# последствия: None — тип файловой системы не проверяется.
EXPECTED_NETWORK_FS_TYPE = None

# Минимум свободного места на шаре (байты).
# Допустимо: целое >= 0; умолчание: 0;
# последствия: 0 — проверка свободного места не выполняется.
MIN_NETWORK_FREE_BYTES = 0

# Сколько проверенных копий хранить на каждый источник.
# Допустимо: целое > 0; умолчание: 5;
# последствия: удаление сверх этого числа — только при подтвержденной
#   сетевой копии; при неоднозначности лишняя копия сохраняется.
RETENTION_COUNT = 5

# Таймаут конвейеров (btrfs send | сжатие | gpg), секунды.
# Допустимо: целое >= 1; умолчание: 3600;
# последствия: для больших subvolume на медленном диске увеличьте.
PROCESS_TIMEOUT = 3600

# Журнал операций.
# Допустимо: абсолютный путь; умолчание: /var/log/btrfs-backup.log;
# последствия: пароли в журнал не пишутся.
LOG_FILE = "/var/log/btrfs-backup.log"

# Уровень журналирования.
# Допустимо: DEBUG, INFO, WARNING, ERROR, CRITICAL; умолчание: INFO.
LOG_LEVEL = "INFO"

# Файл блокировки параллельных запусков (flock).
# Допустимо: абсолютный путь; умолчание: /run/lock/btrfs-backup-manager.lock;
# последствия: если файл создать не удается, используется
#   <проект>/logs/.backup.lock.
LOCK_FILE = "/run/lock/btrfs-backup-manager.lock"
